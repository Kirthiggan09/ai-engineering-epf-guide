<mxfile host="app.diagrams.net"><diagram name="Week 3 pipeline" id="w3"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1300" pageHeight="800"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="s1" value="&lt;b&gt;1  SOURCE&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;Official KWSP PDFs&lt;br&gt;(Restructuring, Housing,&lt;br&gt;Education; current only)&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:9px'&gt;&lt;b&gt;FR1 FR2 · NFR5&lt;/b&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;strokeWidth=2;fillColor=#DCEBFA;strokeColor=#2F6DB5;" vertex="1" parent="1"><mxGeometry x="24" y="204" width="174" height="204" as="geometry"/></mxCell><mxCell id="s2" value="&lt;b&gt;2  INGEST&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;select_source() picks each&lt;br&gt;PDF explicitly; pypdf reads&lt;br&gt;page by page&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:9px'&gt;&lt;b&gt;FR3 · NFR4&lt;/b&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;strokeWidth=2;fillColor=#DCEBFA;strokeColor=#2F6DB5;" vertex="1" parent="1"><mxGeometry x="222" y="204" width="174" height="204" as="geometry"/></mxCell><mxCell id="s3" value="&lt;b&gt;3  INSPECT&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;pages loaded, chars/page,&lt;br&gt;empty pages, text sample,&lt;br&gt;repeated-line candidates&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:9px'&gt;&lt;b&gt;FR2 · RAI1&lt;/b&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;strokeWidth=2;fillColor=#DCEBFA;strokeColor=#2F6DB5;" vertex="1" parent="1"><mxGeometry x="420" y="204" width="174" height="204" as="geometry"/></mxCell><mxCell id="s4" value="&lt;b&gt;4  PREPARE /&lt;br&gt;TRANSFORM&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;collapse whitespace;&lt;br&gt;page-aware paragraph chunks&lt;br&gt;(800 chars); keep page + status&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:9px'&gt;&lt;b&gt;FR3 · RAI1 · NFR5&lt;/b&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;strokeWidth=2;fillColor=#DCEBFA;strokeColor=#2F6DB5;" vertex="1" parent="1"><mxGeometry x="618" y="204" width="174" height="204" as="geometry"/></mxCell><mxCell id="s5" value="&lt;b&gt;5  VALIDATE&lt;br&gt;OUTPUT&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;file exists, non-empty;&lt;br&gt;every chunk has text + page;&lt;br&gt;only doc_status = current&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:9px'&gt;&lt;b&gt;NFR4&lt;/b&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;strokeWidth=2;fillColor=#DCEBFA;strokeColor=#2F6DB5;" vertex="1" parent="1"><mxGeometry x="816" y="204" width="174" height="204" as="geometry"/></mxCell><mxCell id="s6" value="&lt;b&gt;6  RECORD&lt;br&gt;LINEAGE&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;source SHA-256 → prepared&lt;br&gt;file; week3_manifest.json +&lt;br&gt;pipeline_manifest.json&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:9px'&gt;&lt;b&gt;FR3 · NFR4&lt;/b&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;strokeWidth=2;fillColor=#DCEBFA;strokeColor=#2F6DB5;" vertex="1" parent="1"><mxGeometry x="1014" y="204" width="174" height="204" as="geometry"/></mxCell><mxCell id="cfg" value="&lt;b&gt;Cell P project configuration&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;doc_status · version · accessed date · source URL · chunk size&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;strokeWidth=2;fillColor=#ECECEC;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="696" y="36" width="432" height="96" as="geometry"/></mxCell><mxCell id="f1" value="&lt;b&gt;FAILURE POINT 1 — at INSPECT&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;Scanned / image-only page:&lt;br&gt;extracted text is empty&lt;br&gt;→ flag page and skip it; stop if the whole&lt;br&gt;PDF has no text (OCR = later iteration)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;strokeWidth=2;fillColor=#FDE3E1;strokeColor=#C0392B;" vertex="1" parent="1"><mxGeometry x="264" y="516" width="336" height="156" as="geometry"/></mxCell><mxCell id="f2" value="&lt;b&gt;FAILURE POINT 2 — at VALIDATE / LINEAGE&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;Output missing/empty, or source or output&lt;br&gt;SHA-256 does not match the manifest&lt;br&gt;(KWSP file replaced or changed)&lt;br&gt;→ stop and report; re-check doc_status/version, rerun&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;strokeWidth=2;fillColor=#FDE3E1;strokeColor=#C0392B;" vertex="1" parent="1"><mxGeometry x="744" y="516" width="444" height="156" as="geometry"/></mxCell><mxCell id="e1" value="" style="endArrow=block;html=1;strokeWidth=2;strokeColor=#333333;" edge="1" parent="1" source="s1" target="s2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="" style="endArrow=block;html=1;strokeWidth=2;strokeColor=#333333;" edge="1" parent="1" source="s2" target="s3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value="" style="endArrow=block;html=1;strokeWidth=2;strokeColor=#333333;" edge="1" parent="1" source="s3" target="s4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" value="" style="endArrow=block;html=1;strokeWidth=2;strokeColor=#333333;" edge="1" parent="1" source="s4" target="s5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" value="" style="endArrow=block;html=1;strokeWidth=2;strokeColor=#333333;" edge="1" parent="1" source="s5" target="s6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e6" value="" style="endArrow=block;html=1;strokeWidth=2;strokeColor=#333333;" edge="1" parent="1" source="cfg" target="s4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e7" value="" style="endArrow=block;html=1;strokeWidth=2;dashed=1;strokeColor=#C0392B;" edge="1" parent="1" source="f1" target="s3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e8" value="" style="endArrow=block;html=1;strokeWidth=2;dashed=1;strokeColor=#C0392B;" edge="1" parent="1" source="f